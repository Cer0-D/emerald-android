<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cer0.emerald"
    android:versionCode="1"
    android:versionName="see build_apk.sh">

    <uses-sdk android:minSdkVersion="33" android:targetSdkVersion="33" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="Emerald for Android"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density"
            android:launchMode="singleTask"
            android:resizeableActivity="false">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.GAME" />
            </intent-filter>
        </activity>
    </application>
</manifest>
